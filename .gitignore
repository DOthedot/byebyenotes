.worktrees/
node_modules/
.playwright-mcp/
# Keep generated/specification docs local, but retain the shared issue log.
docs/*
!docs/issues/
!docs/issues/**

# Local secrets — never commit (e.g. GITHUB_TOKEN for the pick-issues skill)
.env
.env.*
!.env.example

# Ignore local Claude state, but share the project subagents/hooks/settings
.claude/*
!.claude/agents/
!.claude/hooks/
!.claude/settings.json
.claude/reviews/

# macOS finder metadata — never useful in the repo
.DS_Store
