# Copy to .env and fill in real values. .env is gitignored; this template is safe to commit.

# GitHub Personal Access Token (fine-grained) used by the pick-issues skill.
# Needs Repository permissions on this repo: Issues (RW), Pull requests (RW), Metadata (R).
# Create at: https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Railway Postgres ──────────────────────────────────────────────────────────
# Railway's dashboard shows these as ${{VAR}} template refs, which only resolve
# inside Railway. Copy the *resolved* values into .env for local use.
PGUSER=postgres
PGPASSWORD=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PGDATABASE=railway
PGPORT=5432

# Internal address — resolvable only from inside Railway's private network.
# This is what the deployed app uses.
DATABASE_URL=postgresql://postgres:PASSWORD@HOST.railway.internal:5432/railway

# Public TCP proxy — needed to connect from a laptop and to run migrations.
DATABASE_PUBLIC_URL=postgresql://postgres:PASSWORD@PROXY_HOST.proxy.rlwy.net:PORT/railway

# ── Sync auth ────────────────────────────────────────────────────────────────
# Peppers the HMAC that turns the client's sync key into users.lookup_key.
# api/sync.js returns 503 without it, by design — a missing pepper must fail
# closed rather than silently store everyone under an empty-key HMAC.
#
# MUST be byte-identical everywhere that serves /api/sync. Rotating it does not
# invalidate sessions, it orphans rows: every existing user's lookup_key stops
# resolving and their notes become unreachable.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SYNC_PEPPER=

# ── Redis (Railway) ──────────────────────────────────────────────────────────
# Short links only (api/tiny.js). On Railway, set it on the byebyenotes service as
# the reference variable ${{Redis.REDIS_URL}} so the private host and password
# resolve there and are never copied by hand. From a laptop the private host does
# not resolve — use the Redis service's public TCP proxy URL instead.
# Leave unset and /api/tiny returns 503; sharing falls back to the full-hash link.
# Pasted images are in Postgres (api/img.js) and need DATABASE_URL + SYNC_PEPPER.
REDIS_URL=
